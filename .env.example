PORT=3000

# Get a free key at https://the-odds-api.com (sign up, no credit card for the free tier)
ODDS_API_KEY=your_api_key_here

# How long (in seconds) to reuse the last fetched odds before calling The Odds API again.
# Lower = fresher data but burns through your monthly request quota faster.
# Free tier is 500 requests/month total, so 60s is a safe default for personal use.
CACHE_TTL_SECONDS=60
